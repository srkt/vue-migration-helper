{
  "name": "vue-migration-helper",
  "displayName": "Vue Migration Helper",
  "description": "Selective / Incremental Vue 2 Class → Vue 3 Composition API",
  "version": "0.1.0",
  "publisher": "yourname",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:vue"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "vue-migrate.props", "title": "Migrate: Props (@Prop / @Model / @PropSync)" },
      { "command": "vue-migrate.emits", "title": "Migrate: Emits (@Emit / $emit)" },
      { "command": "vue-migrate.computed", "title": "Migrate: Computed Properties" },
      { "command": "vue-migrate.watch", "title": "Migrate: Watchers (@Watch)" },
      { "command": "vue-migrate.method", "title": "Migrate: Selected Method" },
      { "command": "vue-migrate.lifecycle", "title": "Migrate: Lifecycle Hooks" },
      { "command": "vue-migrate.refs", "title": "Migrate: @Ref" },
      { "command": "vue-migrate.vuex", "title": "Migrate: Vuex Decorators" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
